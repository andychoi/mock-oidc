<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>mock-oidc | Just a mock login</title>
    <meta name="description" content="">
    <meta name="author" content="">
    <style>
        body { font-family: -apple-system, "Segoe UI", Helvetica, Arial, sans-serif; background: #fafafa; color: #222; margin: 0; }
        .container { max-width: 640px; margin: 3rem auto; padding: 0 1rem; }
        .card { background: #fff; border: 1px solid #e3e3e3; border-radius: 6px; padding: 1.5rem; }
        input[type=text], textarea { width: 100%; box-sizing: border-box; padding: .5rem; margin: .25rem 0 1rem; border: 1px solid #ccc; border-radius: 4px; font: inherit; }
        .button-primary { background: #1eaedb; color: #fff; border: none; border-radius: 4px; padding: .6rem 1.2rem; font-size: 1rem; cursor: pointer; }
        .docs-header { margin: 2rem 0 .5rem; color: #999; font-size: .8rem; text-transform: uppercase; letter-spacing: .1em; }
        .param { text-align: left; color: grey; font-size: .85rem; word-break: break-all; }
    </style>
</head>
<body>
<div class="container">
    <div class="card">
        <h2>Mock OIDC Server Sign-in</h2>
        <form method="post">
            <label for="username">Username (any user/subject)</label>
            <input class="u-full-width" required type="text" id="username" name="username"
                   placeholder="Enter any user/subject" autofocus>
            <label for="claims">Optional claims JSON</label>
            <textarea class="u-full-width claims" id="claims" name="claims" rows="8"
                      placeholder='Optional claims JSON value, example:
{
  "acr": "reference"
}'></textarea>
            <input class="button-primary" type="submit" value="Sign-in">
        </form>
    </div>
    <div class="card">
        <h6 class="docs-header">Authorization Request</h6>
        {{range .}}
        <div class="param"><strong>{{.Name}}</strong> = {{.Value}}</div>
        {{end}}
    </div>
</div>
</body>
</html>
