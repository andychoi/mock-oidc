<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>mock-oidc debugger | Just a mock oauth2 client</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        body { font-family: -apple-system, "Segoe UI", Helvetica, Arial, sans-serif; background: #fafafa; color: #222; margin: 0; }
        .container { max-width: 680px; margin: 2rem auto; padding: 0 1rem; }
        .card { background: #fff; border: 1px solid #e3e3e3; border-radius: 6px; padding: 1.5rem; margin-bottom: 1.5rem; }
        h2 { margin-top: 0; }
        .docs-header { margin: 0 0 .75rem; color: #999; font-size: .8rem; text-transform: uppercase; letter-spacing: .1em; }
        label { display: block; font-size: .85rem; margin-top: .9rem; }
        input[type=text] { width: 100%; box-sizing: border-box; padding: .45rem; border: 1px solid #ccc; border-radius: 4px; font: inherit; }
        input[readonly] { background: #f4f4f4; }
        .button-primary { background: #1eaedb; color: #fff; border: none; border-radius: 4px; padding: .6rem 1.2rem; font-size: 1rem; cursor: pointer; margin-top: 1.2rem; }
        .hint { color: grey; font-size: .8rem; margin-bottom: .25rem; }
    </style>
</head>
<body>
<div class="container">
    <div class="card">
        <h2>OAuth2 Client Debugger</h2>
        <div class="docs-header">OpenID Connect</div>
        <p>Insert your parameters here to run the Authorization Code Flow against this server</p>
        <form method="post">
            <label for="authorize_url">Authorization Endpoint</label>
            <input type="text" name="authorize_url" value="{{.authorize_url}}" readonly>
            <label for="token_url">Token Endpoint</label>
            <input type="text" name="token_url" value="{{.token_url}}" readonly>
            <label for="client_auth_method">Client Authentication Method</label>
            <input type="text" placeholder="Client auth method" name="client_auth_method" value="{{.client_auth_method}}">
            <label for="client_id">Client Id</label>
            <input type="text" placeholder="Any client_id, this server does not require registration" name="client_id" value="{{.client_id}}">
            <label for="client_secret">Client Secret (used to acquire token when callback is received)</label>
            <input type="text" placeholder="Any client_secret, this server does not require registration" name="client_secret" value="{{.client_secret}}">
            <label for="scope">Scope</label>
            <input type="text" placeholder="Scopes space separated, should include 'openid'" name="scope" value="{{.scope}}">
            <label for="response_type">Response Type</label>
            <input type="text" placeholder="Choice between [code, token, id_token]" name="response_type" value="{{.response_type}}">
            <label for="response_mode">Response Mode</label>
            <input type="text" placeholder="Choice between [query, fragment, form_post]" name="response_mode" value="{{.response_mode}}">
            <label for="state">State</label>
            <input type="text" placeholder="A state value to protect against CSRF" name="state" value="{{.state}}">
            <label for="nonce">Nonce</label>
            <input type="text" placeholder="A nonce value to include in token (for replay protection)" name="nonce" value="{{.nonce}}">
            <label for="redirect_uri">Redirect URI (callback)</label>
            <p class="hint">The debugger's own callback, which completes the flow and displays the token response</p>
            <input type="text" name="redirect_uri" value="{{.redirect_uri}}" readonly>
            <input class="button-primary" type="submit" value="Get a token">
        </form>
    </div>
    <div class="card">
        <div class="docs-header">more debugging options</div>
        <p>More options will be added shortly</p>
    </div>
</div>
</body>
</html>
