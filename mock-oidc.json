{
  "interactiveLogin": true,
  "loginPagePath": "/config/mock-oidc-login.html",
  "httpServer": {
    "ssl": {
      "certificateFile": "/config/tls/oidc.dev.test.pem",
      "privateKeyFile": "/config/tls/oidc.dev.test-key.pem"
    }
  },
  "tokenCallbacks": [
    {
      "issuerId": "oidc",
      "tokenExpiry": 3600,
      "requestMappings": [
        {
          "requestParam": "grant_type",
          "match": "authorization_code",
          "claims": {
            "tid": "mock-tenant-id"
          }
        }
      ]
    }
  ]
}
